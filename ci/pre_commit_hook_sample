# This sample pre-commit hook runs local checks that mirror the WAMR CI coding
# guidelines where possible. Skipped checks are treated as successful.

set -o pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

temp_files=()
cleanup_temp_files() {
    if [ ${#temp_files[@]} -gt 0 ]; then
        rm -f "${temp_files[@]}"
    fi
}
trap cleanup_temp_files EXIT

staged_tmp_file=""
write_staged_file_to_temp() {
    source_file="$1"
    staged_tmp_file=$(mktemp "${TMPDIR:-/tmp}/wamr-pre-commit.XXXXXX") || return $?
    temp_files+=("$staged_tmp_file")
    git show ":$source_file" > "$staged_tmp_file"
}

run_check() {
    check_name="$1"
    shift

    echo "=== $check_name ==="
    "$@"
    status=$?
    if [ $status -ne 0 ]; then
        echo "--- $check_name: failed"
        exit $status
    fi
    echo "--- $check_name: success"
}

run_hadolint() {
    dockerfiles=()
    while IFS= read -r dockerfile; do
        dockerfiles+=("$dockerfile")
    done < <(
        git diff --cached --name-only --diff-filter=ACMR \
            | grep -E '(^|/)Dockerfile[^/]*$' || true
    )

    if [ ${#dockerfiles[@]} -eq 0 ]; then
        echo "--- hadolint: skipped (no staged Dockerfiles)"
        return 0
    fi

    if ! command -v hadolint >/dev/null 2>&1; then
        echo "--- hadolint: skipped (hadolint not found)"
        return 0
    fi

    for dockerfile in "${dockerfiles[@]}"; do
        write_staged_file_to_temp "$dockerfile" || return $?
        echo "--- hadolint: checking $dockerfile"
        hadolint "$staged_tmp_file" || return $?
    done
}

run_actionlint() {
    workflows=()
    while IFS= read -r workflow; do
        workflows+=("$workflow")
    done < <(
        git diff --cached --name-only --diff-filter=ACMR \
            | grep -E '^\.github/workflows/.*\.ya?ml$' || true
    )

    if [ ${#workflows[@]} -eq 0 ]; then
        echo "--- actionlint: skipped (no staged GitHub workflow files)"
        return 0
    fi

    if ! command -v actionlint >/dev/null 2>&1; then
        echo "--- actionlint: skipped (actionlint not found)"
        return 0
    fi

    for workflow in "${workflows[@]}"; do
        write_staged_file_to_temp "$workflow" || return $?
        echo "--- actionlint: checking $workflow"
        actionlint "$staged_tmp_file" || return $?
    done
}

run_check "coding guidelines" /usr/bin/env python3 ./ci/coding_guidelines_check.py --staged
run_check "clang-tidy" /usr/bin/env python3 ./ci/clang_tidy_diff_check.py --staged
run_check "hadolint" run_hadolint
run_check "actionlint" run_actionlint
