import os
import sys
from building import *

cwd = GetCurrentDir()
sys.path.insert(0, os.path.abspath(os.path.join(cwd, '../../../../build-scripts')))
from rtthread_config import platform_sources

# File/socket adapters belong to WASI, not every vmcore consumer.
group = DefineGroup('iwasm_platform_core', platform_sources(GetDepend),
                    depend=['PKG_USING_WAMR'],
                    CPPPATH=[cwd, cwd + '/../include'])
Return('group')
