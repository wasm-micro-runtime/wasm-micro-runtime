import os
import sys
from building import *

cwd = GetCurrentDir()
sys.path.insert(0, os.path.abspath(os.path.join(cwd, '../../../build-scripts')))
from rtthread_config import interpreter_sources

# Use the same derived feature set as the global compiler definitions.
group = DefineGroup('iwasm_interpreter', interpreter_sources(GetDepend),
                    depend=['PKG_USING_WAMR'], CPPPATH=[cwd])
Return('group')
