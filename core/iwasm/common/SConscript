import os
import sys
from building import *

Import('rtconfig')
cwd = GetCurrentDir()
sys.path.insert(0, os.path.abspath(os.path.join(cwd, '../../../build-scripts')))
from rtthread_config import target_config

target, invoke_native = target_config(rtconfig)
native_source = os.path.join(cwd, 'arch', invoke_native)
if not os.path.isfile(native_source):
    raise ValueError('WAMR native-call assembly does not exist: ' + native_source)
src = Glob('*.c') + [native_source]
group = DefineGroup('iwasm_common', src, depend=['PKG_USING_WAMR'],
                    CPPPATH=[cwd, cwd + '/../include'])
Return('group')
