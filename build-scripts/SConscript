import os
import sys
from building import *

cwd = GetCurrentDir()
root = os.path.abspath(os.path.join(cwd, '..'))
sys.path.insert(0, cwd)
from rtthread_config import feature_config, runtime_scripts, validate_config

features = feature_config(GetDepend)
validate_config(GetDepend, features)
scripts = runtime_scripts(features, root)
# Establish one consistent macro set before selecting runtime sources.
objs = SConscript(os.path.join(cwd, 'SConscript_config'))
for feature in ('AOT', 'LIBC_WASI', 'THREAD_MGR'):
    if features[feature]:
        print('[WAMR] %s selected: RT-Thread backend integration is experimental; '
              'P0 tests do not validate it' % feature)
for script in scripts:
    objs += SConscript(os.path.join(root, script))
Return('objs')
