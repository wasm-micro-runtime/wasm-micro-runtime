import os
import sys
from building import *

Import('rtconfig')
cwd = GetCurrentDir()
sys.path.insert(0, cwd)
from rtthread_config import compile_definitions

group = DefineGroup('wamr', [], depend=['PKG_USING_WAMR'],
                    CPPPATH=[os.path.join(cwd, '..', 'core', 'iwasm', 'include')],
                    CPPDEFINES=compile_definitions(rtconfig, GetDepend,
                                                   GetConfigValue),
                    LIBS=['m'])
Return('group')
