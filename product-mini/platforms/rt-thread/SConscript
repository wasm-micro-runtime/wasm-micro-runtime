import os
import sys
from building import *

cwd = GetCurrentDir()
sys.path.insert(0, os.path.abspath(os.path.join(cwd, '../../../build-scripts')))
from rtthread_config import product_sources

# Both entry points are optional. The runtime can also be embedded directly.
src = product_sources(GetDepend)
group = DefineGroup('iwasm', src, depend=['PKG_USING_WAMR'], CPPPATH=[cwd])
Return('group')
