set (CMAKE_SYSTEM_NAME Generic)
set (CMAKE_SYSTEM_PROCESSOR aarch64)
set (CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if (NOT DEFINED RTEMS_TOOLCHAIN_PATH)
    set (RTEMS_TOOLCHAIN_PATH "/opt/rtems/7")
endif ()

if (NOT DEFINED RTEMS_BSP_PATH)
    set (RTEMS_BSP_PATH "")
endif ()

if (NOT DEFINED RTEMS_CPU_MODEL)
    set (RTEMS_CPU_MODEL "cortex-a53")
endif ()

if (NOT DEFINED RTEMS_COMPILER_PREFIX)
    set (RTEMS_COMPILER_PREFIX "aarch64-rtems7-")
endif ()

set (CMAKE_C_COMPILER
    "${RTEMS_TOOLCHAIN_PATH}/bin/${RTEMS_COMPILER_PREFIX}gcc")
set (CMAKE_CXX_COMPILER
    "${RTEMS_TOOLCHAIN_PATH}/bin/${RTEMS_COMPILER_PREFIX}g++")
set (CMAKE_AR
    "${RTEMS_TOOLCHAIN_PATH}/bin/${RTEMS_COMPILER_PREFIX}ar" CACHE FILEPATH "" FORCE)
set (CMAKE_RANLIB
    "${RTEMS_TOOLCHAIN_PATH}/bin/${RTEMS_COMPILER_PREFIX}ranlib" CACHE FILEPATH "" FORCE)

set (CMAKE_C_FLAGS_INIT
    "-mcpu=${RTEMS_CPU_MODEL} -mfix-cortex-a53-835769 -mfix-cortex-a53-843419")
set (CMAKE_CXX_FLAGS_INIT
    "-mcpu=${RTEMS_CPU_MODEL} -mfix-cortex-a53-835769 -mfix-cortex-a53-843419")

set (CMAKE_C_FLAGS_DEBUG "-O0 -g")
set (CMAKE_CXX_FLAGS_DEBUG "-O0 -g")
set (CMAKE_C_FLAGS_RELEASE "-O2")
set (CMAKE_CXX_FLAGS_RELEASE "-O2")

set (CMAKE_EXE_LINKER_FLAGS
    "-B${RTEMS_BSP_PATH}/lib -qrtems -Wl,--gc-sections" CACHE STRING "" FORCE)

set (CMAKE_FIND_ROOT_PATH ${RTEMS_BSP_PATH})
set (CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set (CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set (CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
