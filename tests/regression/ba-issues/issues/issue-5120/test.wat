(module
  (type $i32_result (func (result i32)))
  (type $v128_to_v128 (func (param v128) (result v128)))
  (type $v128_to_pair (func (param v128) (result v128 v128)))

  (func $control (type $i32_result)
    (v128.const i32x4 1 2 3 4)
    (v128.const i32x4 10 20 30 40)
    (i32x4.add)
    (i32x4.extract_lane 2)
  )

  (func $block_param (type $i32_result)
    (v128.const i32x4 1 2 3 4)
    (block (type $v128_to_v128)
      (v128.const i32x4 10 20 30 40)
      (i32x4.add)
    )
    (i32x4.extract_lane 2)
  )

  (func $loop_param (type $i32_result)
    (local $count i32)
    (i32.const 5)
    (local.set $count)
    (v128.const i32x4 1 2 3 4)
    (loop (type $v128_to_v128)
      (v128.const i32x4 1 1 1 1)
      (i32x4.add)
      (local.get $count)
      (i32.const 1)
      (i32.sub)
      (local.tee $count)
      (br_if 0)
    )
    (i32x4.extract_lane 2)
  )

  (func $two_results (type $v128_to_pair)
    (local.get 0)
    (local.get 0)
    (v128.not)
  )

  (func $multi_value (type $i32_result)
    (v128.const i32x4 1 2 3 4)
    (call $two_results)
    (v128.xor)
    (i32x4.extract_lane 2)
  )

  (func (export "to_test") (type $i32_result)
    (i32.or
      (i32.or
        (i32.or
          (i32.ne (call $control) (i32.const 33))
          (i32.ne (call $block_param) (i32.const 33))
        )
        (i32.ne (call $loop_param) (i32.const 8))
      )
      (i32.ne (call $multi_value) (i32.const -1))
    )
  )
)
