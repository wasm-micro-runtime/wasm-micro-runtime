;; Tail calls to functions of another module (--module-path)
(module
  (import "lib" "mix" (func $mix (param i64 i32 f64) (result i64)))
  (import "lib" "inc" (func $inc (param i32) (result i32)))
  (func (export "top") (param i32) (result i64)
    (return_call $mix (i64.const 7) (local.get 0) (f64.const 2.5)))
  (func $mid (param i32) (result i64)
    (return_call $mix (i64.const 7) (local.get 0) (f64.const 2.5)))
  (func (export "nested") (param i32) (result i64)
    (i64.add (call $mid (local.get 0)) (i64.const 1)))
  (func $loop (param i32 i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0)) (then (return_call $inc (local.get 1)))
      (else (return_call $loop (i32.sub (local.get 0) (i32.const 1)) (call $inc (local.get 1))))))
  (func (export "loop") (param i32) (result i32) (call $loop (local.get 0) (i32.const 0))))
